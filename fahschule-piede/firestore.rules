rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for opening hours / settings used by the website.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Signup records and outbound mail must only be written by the
    // server (Admin SDK). Client SDK creates are denied to stop spam.
    match /anmeldung/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
